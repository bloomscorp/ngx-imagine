{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false
  },
  "projects": {
    "@bloomscorp/ngx-imagine": {
      "projectType": "library",
      "root": "projects/bloomscorp/ngx-imagine",
      "sourceRoot": "projects/bloomscorp/ngx-imagine/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/bloomscorp/ngx-imagine/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/bloomscorp/ngx-imagine/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/bloomscorp/ngx-imagine/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/bloomscorp/ngx-imagine/tsconfig.spec.json",
            "runner": "vitest",
            "coverageInclude": [
              "projects/bloomscorp/ngx-imagine/src/lib/**/*.ts"
            ],
            "coverageExclude": [
              "**/*.spec.ts"
            ],
            "coverageReporters": [
              "text-summary",
              "html",
              "lcovonly"
            ],
            "isolate": true,
            "coverageThresholds": {
              "perFile": true,
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            }
          }
        }
      }
    }
  }
}
